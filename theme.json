{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [
        {
          "slug": "primary-to-accent",
          "name": "Primary to Accent",
          "gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--accent) 100%)"
        },
        {
          "slug": "dark-to-primary",
          "name": "Dark to Primary",
          "gradient": "linear-gradient(135deg, var(--wp--preset--color--base-dark) 0%, var(--wp--preset--color--primary) 100%)"
        },
        {
          "slug": "subtle",
          "name": "Subtle",
          "gradient": "linear-gradient(180deg, var(--wp--preset--color--base-2) 0%, var(--wp--preset--color--base) 100%)"
        }
      ],
      "palette": [
        {
          "slug": "base",
          "name": "Base",
          "color": "#ffffff"
        },
        {
          "slug": "base-2",
          "name": "Base 2",
          "color": "#f8f9fa"
        },
        {
          "slug": "base-3",
          "name": "Base 3",
          "color": "#f1f3f5"
        },
        {
          "slug": "base-dark",
          "name": "Base Dark",
          "color": "#0d0f12"
        },
        {
          "slug": "contrast",
          "name": "Contrast",
          "color": "#111318"
        },
        {
          "slug": "contrast-2",
          "name": "Contrast 2",
          "color": "#3d4451"
        },
        {
          "slug": "contrast-3",
          "name": "Contrast 3",
          "color": "#6b7280"
        },
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#2563eb"
        },
        {
          "slug": "primary-dark",
          "name": "Primary Dark",
          "color": "#1d4ed8"
        },
        {
          "slug": "primary-light",
          "name": "Primary Light",
          "color": "#dbeafe"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#7c3aed"
        },
        {
          "slug": "accent-light",
          "name": "Accent Light",
          "color": "#ede9fe"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#16a34a"
        },
        {
          "slug": "warning",
          "name": "Warning",
          "color": "#d97706"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "#dc2626"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#e5e7eb"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System UI",
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "slug": "mono",
          "name": "Monospace",
          "fontFamily": "'Cascadia Code', 'Fira Code', 'Consolas', monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "clamp(0.75rem,  0.7rem  + 0.25vw, 0.875rem)"
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "clamp(0.875rem, 0.825rem + 0.25vw, 1rem)"
        },
        {
          "slug": "md",
          "name": "Medium",
          "size": "clamp(1rem,     0.95rem  + 0.25vw, 1.125rem)"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "clamp(1.125rem, 1rem     + 0.625vw, 1.375rem)"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "clamp(1.25rem,  1.05rem  + 1vw,    1.75rem)"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "clamp(1.5rem,   1.2rem   + 1.5vw,  2.25rem)"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "clamp(1.875rem, 1.4rem   + 2.375vw, 3rem)"
        },
        {
          "slug": "4xl",
          "name": "4XL",
          "size": "clamp(2.25rem,  1.6rem   + 3.25vw,  3.75rem)"
        },
        {
          "slug": "5xl",
          "name": "5XL",
          "size": "clamp(3rem,     2rem     + 5vw,     5rem)"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "0.25rem"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "0.5rem"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "0.75rem"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "1rem"
        },
        {
          "slug": "5",
          "name": "5",
          "size": "1.25rem"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "1.5rem"
        },
        {
          "slug": "8",
          "name": "8",
          "size": "2rem"
        },
        {
          "slug": "10",
          "name": "10",
          "size": "2.5rem"
        },
        {
          "slug": "12",
          "name": "12",
          "size": "3rem"
        },
        {
          "slug": "16",
          "name": "16",
          "size": "4rem"
        },
        {
          "slug": "20",
          "name": "20",
          "size": "5rem"
        },
        {
          "slug": "24",
          "name": "24",
          "size": "6rem"
        },
        {
          "slug": "32",
          "name": "32",
          "size": "8rem"
        }
      ],
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "xs",
          "name": "XS",
          "shadow": "0 1px 2px 0 rgb(0 0 0 / 0.05)"
        },
        {
          "slug": "sm",
          "name": "Small",
          "shadow": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)"
        },
        {
          "slug": "md",
          "name": "Medium",
          "shadow": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)"
        },
        {
          "slug": "lg",
          "name": "Large",
          "shadow": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
        },
        {
          "slug": "xl",
          "name": "XL",
          "shadow": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "shadow": "0 25px 50px -12px rgb(0 0 0 / 0.25)"
        }
      ]
    },
    "custom": {
      "radius": {
        "sm": "0.375rem",
        "md": "0.5rem",
        "lg": "0.75rem",
        "xl": "1rem",
        "2xl": "1.5rem",
        "full": "9999px"
      },
      "transition": {
        "fast": "150ms ease",
        "base": "200ms ease",
        "slow": "300ms ease"
      },
      "zIndex": {
        "dropdown": "1000",
        "sticky": "1020",
        "modal": "1050",
        "toast": "1080"
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": true,
          "text": true
        }
      },
      "core/image": {
        "lightbox": {
          "allowEditing": true
        }
      },
      "core/navigation": {
        "layout": {
          "allowSwitching": false
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base-dark)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.7",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--8)",
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "0",
        "right": "0"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          },
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4xl)",
          "fontWeight": "800",
          "lineHeight": "1.15",
          "letterSpacing": "-0.025em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3xl)",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "letterSpacing": "-0.02em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2xl)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "600",
          "lineHeight": "1.4"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--lg)",
          "fontWeight": "600"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--md)",
          "fontWeight": "600"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "600",
          "letterSpacing": "0.01em"
        },
        "border": {
          "radius": "var(--wp--custom--radius--md)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--3)",
            "bottom": "var(--wp--preset--spacing--3)",
            "left": "var(--wp--preset--spacing--6)",
            "right": "var(--wp--preset--spacing--6)"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "800"
        },
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "500"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--border)"
        },
        "border": {
          "color": "var(--wp--preset--color--border)",
          "width": "1px"
        }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--sm)"
        },
        "color": {
          "background": "var(--wp--preset--color--base-3)",
          "text": "var(--wp--preset--color--contrast)"
        },
        "border": {
          "radius": "var(--wp--custom--radius--sm)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--4)",
            "bottom": "var(--wp--preset--spacing--4)",
            "left": "var(--wp--preset--spacing--6)",
            "right": "var(--wp--preset--spacing--6)"
          }
        }
      },
      "core/quote": {
        "border": {
          "color": "var(--wp--preset--color--primary)",
          "style": "solid",
          "width": "0 0 0 4px"
        },
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--6)"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--lg)",
          "fontStyle": "italic"
        }
      },
      "core/pullquote": {
        "border": {
          "color": "var(--wp--preset--color--primary)",
          "style": "solid",
          "width": "2px 0"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2xl)",
          "fontStyle": "italic",
          "fontWeight": "300"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)"
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4xl)",
          "fontWeight": "800",
          "lineHeight": "1.15"
        }
      },
      "core/post-excerpt": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--lg)"
        },
        "color": {
          "text": "var(--wp--preset--color--contrast-2)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "header-minimal",
      "title": "Header Minimal",
      "area": "header"
    },
    {
      "name": "header-dark",
      "title": "Header Dark",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "footer-minimal",
      "title": "Footer Minimal",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank",
      "postTypes": [
        "page",
        "post"
      ]
    },
    {
      "name": "full-width",
      "title": "Full Width",
      "postTypes": [
        "page",
        "post"
      ]
    },
    {
      "name": "landing",
      "title": "Landing Page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "docs",
      "title": "Documentation",
      "postTypes": [
        "page"
      ]
    }
  ]
}